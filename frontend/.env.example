# Copiar a .env y ajustar. Nunca commitear .env con valores reales (ya está
# en .gitignore).

# --- Google OAuth (Google Identity Services) ---
# TIENE QUE SER EL MISMO VALOR que GOOGLE_CLIENT_ID en server/.env -- no son
# credenciales independientes, son el mismo Client ID de un mismo proyecto de
# Google Cloud Console (https://console.cloud.google.com/apis/credentials).
# El server valida que el `audience` del ID token coincida con este Client ID;
# si difieren, el login falla con invalid_credential aunque ambos estén
# "configurados". Vacío hasta tener credenciales reales (ver CLAUDE.md,
# sección "Pendiente / decisiones abiertas").
VITE_GOOGLE_CLIENT_ID=

# --- Gating de métodos de login ---
# Mismo nombre/semántica que AUTH_METHODS_ENABLED en server/.env (lyon):
# lista separada por comas, subconjunto de password,google,phone. Si está
# vacía o no seteada, default a los 3 (igual que el backend). Filtra qué
# tabs renderiza AuthTabs.jsx -- no borra los componentes, solo no los monta.
VITE_AUTH_METHODS=password,google,phone

# --- Redirect post-login ---
# URL de la home del sitio vanilla (index.html). Si está seteada, al loguearse
# exitosamente se redirige ahí (window.location.href) en vez de mostrar la
# pantalla "Hola, {email}". El sitio vanilla lo sirve el mismo server de auth
# en :4000 (SERVE_STATIC_SITE, ver server/src/index.js y CLAUDE.md) -- usar
# "localhost", NO "127.0.0.1": la cookie hilo_session se emite para el host
# "localhost" y el browser trata 127.0.0.1 como un host distinto, así que la
# sesión no viajaría.
VITE_HOME_URL=http://localhost:4000
