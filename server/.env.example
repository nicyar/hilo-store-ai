# Copiar a .env y ajustar. Nunca commitear .env con valores reales.

# Puerto del servidor de autenticación.
PORT=4000

# development | production
# En development se relaja el flag `Secure` de la cookie de sesión (porque
# Vite sirve el front por HTTP en localhost). En production la cookie SIEMPRE
# lleva Secure -- ver server/src/lib/cookies.js. NO correr production sin
# HTTPS real delante (nginx/Caddy/plataforma) o los navegadores van a
# rechazar/ignorar la cookie igual, o peor, viajaría sin cifrar.
NODE_ENV=development

# Origen exacto del frontend para CORS (no usar "*" porque las cookies
# requieren credentials:true, que el spec de CORS prohíbe combinar con "*").
CORS_ORIGIN=http://localhost:5173

# Si este server también sirve el sitio vanilla (home + catálogo) además de
# la API -- ver server/src/index.js. Montaje explícito de css/, js/, data/,
# img/, uploads/ + index.html, nunca la raíz del proyecto entera (eso
# expondría server/.env, db/lyondor.sqlite3, frontend/ y el respaldo de
# webauthn/apple). Necesario para que VITE_HOME_URL (frontend/.env) tenga
# un origen real al que redirigir después del login.
# Sin setear (default): on salvo NODE_ENV=production, para que un deploy
# real -- donde nginx/CDN sirve el sitio delante -- no lo duplique por
# accidente. Setear explícito en true/false para pisar ese default.
# SERVE_STATIC_SITE=true

# Ruta a la base SQLite compartida con el catálogo (Lyon). Por defecto se
# calcula relativa a este archivo (../../db/lyondor.sqlite3); solo hace
# falta setear esto si se quiere apuntar a otra copia (ej. testing).
# DB_PATH=C:/ruta/absoluta/db/lyondor.sqlite3

# --- Google OAuth (implementado, falta la credencial real) ---
# El endpoint POST /api/auth/google verifica de verdad el ID token de Google
# Identity Services (google-auth-library, OAuth2Client.verifyIdToken) -- ya
# NO es un stub. Responde 501 solo mientras GOOGLE_CLIENT_ID esté vacío.
# Conseguir el Client ID en
# (https://console.cloud.google.com/apis/credentials -- "Create Credentials
# > OAuth client ID > Web application"), con los orígenes JavaScript
# autorizados registrados (ej. http://localhost:5173 en dev). Ver el
# comentario completo en server/src/routes/authGoogle.js.
#
# OJO: este valor debe ser EXACTAMENTE el mismo que VITE_GOOGLE_CLIENT_ID del
# frontend (frontend/.env) -- es el mismo OAuth client, el frontend lo usa
# para renderizar el botón y el server para verificar el token que ese botón
# entrega.
# GOOGLE_CLIENT_ID=
#
# GOOGLE_CLIENT_SECRET NO se usa -- el flujo de Google Identity Services que
# usa este proyecto entrega un ID token ya firmado (no hace un intercambio de
# código de autorización), así que no hace falta que el server llame a
# Google con un secret. Se deja la variable documentada acá por si en algún
# momento se migra a un flujo distinto que sí lo requiera.
# GOOGLE_CLIENT_SECRET=

# --- Gating de métodos de login (server/src/lib/authMethods.js) ---
# Lista separada por comas de los métodos de login habilitados. Valores
# válidos: "password", "google", "phone" (deben coincidir exactamente con
# VITE_AUTH_METHODS del frontend -- coordinar cualquier cambio con quien
# integre el frontend antes de tocar esto).
#
# Sin setear (default): los tres métodos habilitados -- así ningún deploy
# que no conozca esta variable se rompe.
#
# ESTO NO ES degradación por falta de credenciales (ver mailer.js/sms.js más
# abajo) -- es un apagado deliberado de producto, reversible con solo
# cambiar este valor, sin tocar código ni migraciones. Se aplica en TODOS
# los endpoints de cada método (no solo login): register/login/
# password/forgot/password/reset para "password", request-code/verify-code
# para "phone" -- si no, esos otros endpoints quedan como puerta trasera
# para entrar con un método "apagado". Responden 403 { error:
# "method_disabled" }.
AUTH_METHODS_ENABLED=google

# --- Login por teléfono / envío de SMS (server/src/lib/sms.js) ---
# SMS_PROVIDER vacío (default) = "modo consola": en vez de mandar el SMS de
# verdad, el server loguea el código de verificación completo en su consola
# con el prefijo "[DEV][SMS NO ENVIADO]". Así se puede probar el flujo de
# login/registro por teléfono de punta a punta sin depender de tener ya
# dada de alta una cuenta de SMS transaccional -- que es el caso real hoy.
# Para mandar SMS de verdad, setear SMS_PROVIDER=twilio + las tres
# variables de abajo, todas obtenibles desde https://console.twilio.com
# (Account SID y Auth Token están en el dashboard principal; el número de
# origen se compra/verifica en Phone Numbers > Manage > Active Numbers).
SMS_PROVIDER=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Recuperación de contraseña / envío de email (server/src/lib/mailer.js) ---
# EMAIL_PROVIDER vacío (default) = "modo consola": en vez de mandar el email
# de verdad, el server loguea el link de reset completo en su consola con el
# prefijo "[DEV][EMAIL NO ENVIADO]". Así se puede probar el flujo de
# "olvidé mi contraseña" de punta a punta sin depender de tener ya dada de
# alta una cuenta de email transaccional -- que es el caso real hoy.
# Para mandar emails de verdad, setear EMAIL_PROVIDER=resend + RESEND_API_KEY.
EMAIL_PROVIDER=

# API key de Resend (https://resend.com) -- se consigue en
# https://resend.com/api-keys una vez creada la cuenta. Solo hace falta si
# EMAIL_PROVIDER=resend. Nunca commitear una key real.
# RESEND_API_KEY=

# Remitente que va a aparecer en el email de reset. Con una cuenta de Resend
# sin dominio propio verificado se puede usar su remitente de pruebas
# "onboarding@resend.dev"; para producción hace falta verificar un dominio
# propio en Resend y usar un remitente de ese dominio.
EMAIL_FROM="HILO Store <onboarding@resend.dev>"

# Origen del SITIO (el mismo que sirve home, checkout y /login), para armar
# el link del email de reset (ej. http://localhost:4000/login/?view=reset-password&token=...)
# y las back_urls de Mercado Pago (/checkout.html). En dev es este mismo server
# (:4000), NO el dev server de Vite (:5173); en producción, el dominio real.
# Sin email configurado en dev, `npm run reset-link -- <email>` genera el link.
APP_BASE_URL=http://localhost:4000

# --- Checkout: transferencia bancaria (server/src/lib/checkoutConfig.js) ---
# CBU/alias/titular para que el checkout muestre los datos de transferencia.
# Las TRES tienen que estar cargadas para que el método quede "disponible"
# en GET /api/checkout/config -- si falta cualquiera, se muestra como
# "medio de pago en configuración" en vez de datos incompletos.
# NUNCA se inventa un valor de ejemplo acá (ni siquiera comentado como
# placeholder que parezca real) -- el usuario todavía no proveyó estos
# datos (ver CLAUDE.md, pendientes).
TRANSFERENCIA_CBU=
TRANSFERENCIA_ALIAS=
TRANSFERENCIA_TITULAR=

# --- Checkout: retiro en local (server/src/lib/checkoutConfig.js) ---
# Dirección y horarios del punto de retiro. Mismo criterio que transferencia:
# las DOS tienen que estar cargadas para que "retiro" quede disponible como
# método de envío. Nunca se inventa una dirección de ejemplo.
RETIRO_DIRECCION=
RETIRO_HORARIOS=

# --- Checkout: Mercado Pago Checkout Pro (server/src/routes/orders.js) ---
# Sin ACCESS_TOKEN + PUBLIC_KEY, Mercado Pago queda "no disponible" en
# GET /api/checkout/config, POST /api/orders rechaza payment_method=
# "mercadopago" con 409, y POST /api/orders/:id/pay/mercadopago responde
# 501 "mercadopago_no_configurado" -- nunca se mockea el SDK de pago (ver
# CLAUDE.md, guardrails). Conseguir las credenciales en
# https://www.mercadopago.com.ar/developers/panel/app (usar credenciales de
# PRUEBA para desarrollo, credenciales de PRODUCCIÓN recién para el deploy
# real).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Secret de la firma del webhook (Tus Integraciones > Notificaciones
# webhook, en el mismo panel de developers). Sin este valor, POST
# /api/webhooks/mercadopago rechaza CUALQUIER notificación con 501 -- nunca
# se procesa un webhook sin poder validar su firma primero.
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública donde este server es alcanzable desde internet (para que
# Mercado Pago pueda pegarle a notification_url). En dev (localhost) MP NO
# puede alcanzar este server -- el webhook solo se puede probar de punta a
# punta con un túnel (ej. ngrok) apuntando acá, o ya en un deploy real. Sin
# setear, cae a http://localhost:<PORT> (sirve para que Preference.create
# no rompa en dev, aunque el webhook no vaya a poder dispararse).
# PUBLIC_SERVER_URL=https://tu-dominio-real.com

# --- Revisión de comprobantes de transferencia (server/src/lib/adminAuth.js) ---
# Header `x-admin-key` que exigen GET /api/admin/orders/pending,
# POST /api/admin/orders/:public_code/confirm y /reject, además de
# GET /api/orders/:public_code/comprobante cuando quien pide el archivo no
# es el dueño del pedido (ver admin/comprobantes.html). Sin esta variable,
# TODO acceso a /api/admin/* se rechaza con 501 -- no hay ningún modo
# "sin key configurada = pasa igual".
#
# Generar un valor random propio (ej. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# -- NUNCA un valor "lindo" tipo admin123, y nunca commitear el valor real.
ADMIN_API_KEY=

# --- Checkout: aviso de pedido nuevo por email -- DIFERIDO ---
# El usuario pidió posponer el envío del aviso de pedido nuevo (ver
# CLAUDE.md, "Pendiente / decisiones abiertas"). El pedido se guarda
# completo igual (ver orders/order_items); esta env var queda documentada
# para cuando se retome esa tarea, pero HOY no la lee ningún código.
# PEDIDOS_EMAIL_TO=
